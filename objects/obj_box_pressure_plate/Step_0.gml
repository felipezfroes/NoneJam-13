//==================================================
// NOVO ESTADO
//==================================================

var _novo_estado =
    place_meeting(x, y, obj_box);


//==================================================
// MUDANÇA
//==================================================

if (_novo_estado != pressionada)
{
    pressionada = _novo_estado;

    scr_play_sfx(
        snd_plate,
        0.34,
        pressionada ? 1.00 : 0.74,
        pressionada ? 1.06 : 0.80,
        2
    );
}


//==================================================
// VISUAL
//==================================================

image_index = pressionada ? 1 : 0;